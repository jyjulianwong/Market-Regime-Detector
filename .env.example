# Local development environment variables for Market Regime Detector.
#
# Copy to `.env` (git-ignored) and fill in real values: `cp .env.example .env`.
#
# Source of truth: src/market_regime_detector/common/settings.py (the `Settings`
# class). Every variable here is read with the `MRD_` prefix stripped off by
# pydantic-settings — add/remove/reorder fields in `Settings` first, then mirror
# the change here in the same order and grouping. Deployed Lambdas get these same
# names set directly as function environment variables by Terraform
# (terraform/main.tf) instead of from this file — secrets are passed as plain
# values there rather than read from SSM at runtime.

# =============================================================================
# Core (every deployable: API, batch, training/ingestion scripts)
# =============================================================================

MRD_AWS_REGION=eu-west-2
MRD_S3_BUCKET_NAME=004246189700-jyjulianwong-mrd
MRD_DYNAMODB_TABLE_NAME=jyjulianwong-mrd-models
MRD_LOG_LEVEL=INFO

# =============================================================================
# Provider API keys (ingestion, training, batch)
# =============================================================================

# FRED/ALFRED: https://fred.stlouisfed.org/docs/api/api_key.html (free, instant)
MRD_FRED_API_KEY=
# Alpha Vantage: built but not wired to any first-pass series yet — still
# read by Settings, so it's listed here.
MRD_ALPHA_VANTAGE_API_KEY=

# =============================================================================
# Batch Lambda invocation (local scripts only)
# =============================================================================

# Only used by scripts/promote_model.py's best-effort async invoke of the
# deployed batch Lambda. Leave empty for local-only work; set it to the real
# function name (terraform output batch_lambda_function_name) once Phase 8's
# infrastructure exists and you want promote_model.py to trigger a real run.
MRD_BATCH_LAMBDA_FUNCTION_NAME=

# =============================================================================
# Server only (src/market_regime_detector/server/)
# =============================================================================

# Comma-separated exact origins, no wildcards. Empty means no cross-origin
# access until a real origin (e.g. a GitHub Pages UI) is configured.
MRD_CORS_ALLOWED_ORIGINS=
# Hours before a prediction's `generated_at` is flagged stale at request time —
# ORed with the batch job's own generation-time `is_stale`.
MRD_STALENESS_MAX_AGE_HOURS=36.0
